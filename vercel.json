{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/home",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/",
      "destination": "/home/index.html"
    },
    {
      "source": "/home",
      "destination": "/home/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/home/index.html"
    }
  ]
}
