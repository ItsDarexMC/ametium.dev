 "cleanUrls": true,
"redirects": [
    {
      "source": "/",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/home",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/((?!home|index\\.html|.*\\.).*)",
      "destination": "/404.html"
    }
  ]
}
